import gleam/list
import gleeunit
import gleeunit/should
import puzzle

pub fn main() {
  gleeunit.main()
}

pub fn expand_test() {
  let test_cases = [
    #([0], [1]),
    #([125, 17], [253_000, 1, 7]),
    #([253_000, 1, 7], [253, 0, 2024, 14_168]),
    #([253, 0, 2024, 14_168], [512_072, 1, 20, 24, 28_676_032]),
    #([512_072, 1, 20, 24, 28_676_032], [512, 72, 2024, 2, 0, 2, 4, 2867, 6032]),
    #([512, 72, 2024, 2, 0, 2, 4, 2867, 6032], [
      1_036_288, 7, 2, 20, 24, 4048, 1, 4048, 8096, 28, 67, 60, 32,
    ]),
    #([1_036_288, 7, 2, 20, 24, 4048, 1, 4048, 8096, 28, 67, 60, 32], [
      2_097_446_912, 14_168, 4048, 2, 0, 2, 4, 40, 48, 2024, 40, 48, 80, 96, 2,
      8, 6, 7, 6, 0, 3, 2,
    ]),
    #([0, 1, 10, 99, 999], [1, 2024, 1, 0, 9, 9, 2_021_976]),
  ]

  use #(numbers, expected) <- list.each(test_cases)

  numbers
  |> puzzle.expand
  |> should.equal(expected)
}
